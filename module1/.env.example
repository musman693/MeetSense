# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production

# ─── S3 / MinIO ─────────────────────────────────────────────────────────────
# For local dev: spin up MinIO with docker-compose and point here.
# For production: remove S3_ENDPOINT_URL and set real AWS credentials.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=meetsense
S3_REGION=us-east-1

# ─── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Whisper ─────────────────────────────────────────────────────────────────
# Options: tiny | base | small | medium | large | large-v2 | large-v3
WHISPER_MODEL=base
WHISPER_LANGUAGE=                # leave blank for auto-detect

# ─── pyannote diarization ────────────────────────────────────────────────────
# Accept terms at https://huggingface.co/pyannote/speaker-diarization-3.1
# then create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_YOUR_TOKEN_HERE

# ─── Database (Module 3 hands these over) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://meetsense:meetsense@localhost:5432/meetsense

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
